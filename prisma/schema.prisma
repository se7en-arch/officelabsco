generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Series {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  slug          String    @unique
  tagline       String
  taglineEn     String?
  description   String
  descriptionEn String?
  color         String
  image         String?
  materials     String?
  products      Product[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  nameEn   String?
  slug     String    @unique
  products Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  nameEn        String?
  slug          String      @unique
  sku           String?     @unique
  price         Float
  originalPrice Float?
  description   String
  descriptionEn String?
  dimensions    String?
  weight        String?
  colors        String?
  colorsEn      String?
  material      String?
  materialEn    String?
  image         String
  images        String      @default("[]")
  badge         String?
  featured      Boolean     @default(false)
  archived      Boolean     @default(false)
  stock         Int         @default(10)
  costPrice     Float?
  has3dModel    Boolean     @default(false)
  hasDrawing    Boolean     @default(false)
  hasVisualization Boolean  @default(false)
  seriesId      Int
  categoryId    Int
  series        Series      @relation(fields: [seriesId], references: [id])
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime    @default(now())

  @@index([seriesId])
  @@index([categoryId])
  @@index([featured])
  @@index([archived])
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber Int?
  status      String      @default("pending")
  firstName String
  lastName  String
  email     String
  phone     String
  company   String?
  eik       String?
  vat       String?
  mol       String?
  carrier   String
  delivType String
  city      String
  address   String?
  postcode  String?
  payment     String
  total       Float
  ipAddress   String?
  userAgent   String?
  referer     String?
  acceptLang  String?
  timezone    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  geoCountry  String?
  geoRegion   String?
  geoCity     String?
  geoIsp          String?
  trackingNumber  String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?
  name      String
  slug      String
  price     Float
  quantity  Int
  image     String
  color     String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model PromoCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  discount  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SiteSettings {
  key   String @id
  value String
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  rating    Int      @default(5)
  text      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Dealer {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  companyName     String
  contactName     String
  phone           String
  address         String
  city            String
  companyPostcode String?
  eik             String
  vatRegistered   Boolean         @default(false)
  vatNumber       String?
  status          String          @default("PENDING")
  discountPercent Int             @default(0)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          DealerOrder[]
  addresses       DealerAddress[]

  @@index([status])
}

model DealerAddress {
  id        String  @id @default(cuid())
  dealerId  String
  label     String  @default("Основен адрес")
  address   String
  city      String
  postcode  String?
  isDefault Boolean @default(false)
  dealer    Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
}

model DealerOrder {
  id                 String            @id @default(cuid())
  dealerId           String
  dealer             Dealer            @relation(fields: [dealerId], references: [id])
  orderNumber        Int?
  status             String            @default("new")
  total              Float
  notes              String?
  deliveryAddressId  String?
  deliveryLabel      String?
  deliveryAddress    String?
  deliveryCity       String?
  deliveryPostcode   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              DealerOrderItem[]

  @@index([dealerId])
  @@index([status])
}

model DealerOrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       DealerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  productName String
  productSlug String
  quantity    Int
  unitPrice   Float
  retailPrice Float
  color       String?
  image       String?

  @@index([orderId])
}
